# dependencies
node_modules/

# next.js
.next/
out/

# production
build/
dist/

# python
backend/.venv/
backend/__pycache__/
*.py[cod]
backend/*.db


# editor
.vscode/*
!.vscode/extensions.json

# misc
.DS_Store
*.log
.env*
!.env.example
# 生产构建的空值默认配置必须入库：否则在没 .env* 的机器上 build，
# NEXT_PUBLIC_API_BASE_URL 会被内联成 undefined，页面报"未配置"。
!.env.production

# workbuddy 本地工作数据（会话日志、临时产物），不入库
.workbuddy/

# 分析历史是运行时数据（每次分析都会追加），不入库
backend/history.json
